FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY backend/ProcureHub.Api/ProcureHub.Api.csproj backend/ProcureHub.Api/
COPY backend/ProcureHub.Application/ProcureHub.Application.csproj backend/ProcureHub.Application/
COPY backend/ProcureHub.Domain/ProcureHub.Domain.csproj backend/ProcureHub.Domain/
COPY backend/ProcureHub.Infrastructure/ProcureHub.Infrastructure.csproj backend/ProcureHub.Infrastructure/
RUN dotnet restore backend/ProcureHub.Api/ProcureHub.Api.csproj

COPY backend/ backend/
RUN dotnet publish backend/ProcureHub.Api/ProcureHub.Api.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

RUN addgroup --system appgroup && adduser --system --ingroup appgroup appuser
COPY --from=build /app/publish .
RUN chown -R appuser:appgroup /app
USER appuser

ENV ASPNETCORE_URLS=http://+:5000
ENV ASPNETCORE_ENVIRONMENT=Production
EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD curl -sf http://localhost:5000/swagger/index.html || exit 1

ENTRYPOINT ["dotnet", "ProcureHub.Api.dll"]
